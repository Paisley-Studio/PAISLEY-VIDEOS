{
 "html": [
  "<!DOCTYPE html>",
  "<html lang=\"en\">",
  "<head>",
  "  <meta charset=\"UTF-8\">",
  "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
  "  <title>Number Match</title>",
  "",
  "  <!-- QUICKSAND FONT (Google Fonts) -->",
  "  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">",
  "  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>",
  "  <link href=\"https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">",
  "",
  "  <link rel=\"stylesheet\" href=\"style.css\">",
  "  <script src=\"script.js\" defer></script>",
  "</head>",
  "<body>",
  "  <main class=\"app-shell\">",
  "    <header class=\"topbar\">",
  "      <a class=\"brand\" href=\"#\" aria-label=\"Number Match home\">",
  "        <span class=\"brand-mark\">N</span>",
  "        <span>NUMBER<span class=\"brand-light\">MATCH</span></span>",
  "      </a>",
  "      <span class=\"top-tag\">A MEMORY CHALLENGE</span>",
  "    </header>",
  "",
  "    <section class=\"hero\">",
  "      <p class=\"eyebrow\">THINK • FLIP • MATCH</p>",
  "      <h1>Ready to <span>match?</span></h1>",
  "      <p class=\"intro\">Turn over two cards. Find the numbers that belong together. How good is your memory?</p>",
  "    </section>",
  "",
  "    <section class=\"game-panel\" aria-label=\"Memory game\">",
  "      <div class=\"game-toolbar\">",
  "        <div class=\"level-control\">",
  "          <label for=\"difficulty\">CHOOSE YOUR CHALLENGE</label>",
  "          <select id=\"difficulty\">",
  "            <option value=\"4\">Easy · 4 pairs</option>",
  "            <option value=\"6\" selected>Medium · 6 pairs</option>",
  "            <option value=\"8\">Challenge · 8 pairs</option>",
  "          </select>",
  "        </div>",
  "        <button class=\"restart-button\" id=\"restartButton\" type=\"button\">",
  "          <span aria-hidden=\"true\">↻</span> Restart",
  "        </button>",
  "      </div>",
  "",
  "      <div class=\"stats\" aria-live=\"polite\">",
  "        <div class=\"stat-box\">",
  "          <span class=\"stat-label\">MOVES</span>",
  "          <strong id=\"moves\">0</strong>",
  "        </div>",
  "        <div class=\"stat-box\">",
  "          <span class=\"stat-label\">MATCHED</span>",
  "          <strong id=\"matched\">0 <small>/ 6</small></strong>",
  "        </div>",
  "        <div class=\"stat-box\">",
  "          <span class=\"stat-label\">TIME</span>",
  "          <strong id=\"timer\">00:00</strong>",
  "        </div>",
  "      </div>",
  "",
  "      <div class=\"progress-track\" aria-label=\"Matching progress\">",
  "        <div class=\"progress-fill\" id=\"progressFill\"></div>",
  "      </div>",
  "",
  "      <div class=\"game-grid\" id=\"gameGrid\" aria-label=\"Number cards\"></div>",
  "",
  "      <div class=\"game-message\" role=\"status\">",
  "        <span class=\"message-dot\"></span>",
  "        <span id=\"gameMessage\">Choose any card to begin!</span>",
  "      </div>",
  "    </section>",
  "",
  "    <footer class=\"footer\">",
  "      <span>PAISLEY STUDIO · LEARN BY CREATING</span>",
  "      <span>Every flip brings you closer.</span>",
  "    </footer>",
  "  </main>",
  "",
  "  <div class=\"win-overlay\" id=\"winOverlay\" aria-hidden=\"true\">",
  "    <div class=\"win-card\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"winTitle\">",
  "      <div class=\"win-spark\">✦</div>",
  "      <p class=\"eyebrow\">CHALLENGE COMPLETE</p>",
  "      <h2 id=\"winTitle\">Brilliant matching!</h2>",
  "      <p>You found every pair. Your memory is getting stronger!</p>",
  "      <div class=\"win-stats\">",
  "        <div>",
  "          <span>MOVES</span>",
  "          <strong id=\"finalMoves\">0</strong>",
  "        </div>",
  "        <div>",
  "          <span>TIME</span>",
  "          <strong id=\"finalTime\">00:00</strong>",
  "        </div>",
  "      </div>",
  "      <button class=\"play-again-button\" id=\"playAgainButton\" type=\"button\">",
  "        Play again <span>→</span>",
  "      </button>",
  "    </div>",
  "  </div>",
  "</body>",
  "</html>"
 ],
 "css": [
  "/* ============================================",
  "   NUMBER MATCH — style.css",
  "   Flat, bold colours. No gradients, no blur.",
  "   ============================================ */",
  "",
  "/* 1. Our colours (CSS variables) */",
  ":root {",
  "  --green: #0e4a3f;",
  "  --green-2: #16705f;",
  "  --mint: #e4f4ee;",
  "  --red: #e3242b;",
  "  --red-dark: #b81b21;",
  "  --match: #14936b;",
  "  --ink: #17302b;",
  "  --muted: #5f7570;",
  "  --page: #f4faf7;",
  "  --white: #ffffff;",
  "}",
  "",
  "* {",
  "  box-sizing: border-box;",
  "}",
  "",
  "/* 2. The page */",
  "body {",
  "  margin: 0;",
  "  min-height: 100vh;",
  "  background-color: var(--page);",
  "  color: var(--ink);",
  "  font-family: 'Quicksand', sans-serif;",
  "}",
  "",
  "button, select {",
  "  font: inherit;",
  "}",
  "",
  ".app-shell {",
  "  width: min(1080px, calc(100% - 36px));",
  "  margin: 0 auto;",
  "}",
  "",
  "/* 3. Header */",
  ".topbar {",
  "  min-height: 82px;",
  "  display: flex;",
  "  align-items: center;",
  "  justify-content: space-between;",
  "  border-bottom: 2px solid var(--mint);",
  "}",
  "",
  ".brand {",
  "  display: inline-flex;",
  "  align-items: center;",
  "  gap: 10px;",
  "  color: var(--green);",
  "  text-decoration: none;",
  "  font-weight: 700;",
  "  letter-spacing: .04em;",
  "  font-size: 15px;",
  "}",
  "",
  ".brand-mark {",
  "  display: grid;",
  "  place-items: center;",
  "  width: 34px;",
  "  height: 34px;",
  "  border-radius: 11px;",
  "  background-color: var(--red);",
  "  color: var(--white);",
  "  font-size: 20px;",
  "  font-weight: 700;",
  "}",
  "",
  ".brand-light {",
  "  color: var(--red);",
  "  margin-left: 3px;",
  "}",
  "",
  ".top-tag, .eyebrow, .stat-label,",
  ".level-control label, .footer {",
  "  letter-spacing: .13em;",
  "  font-size: 10px;",
  "  font-weight: 700;",
  "}",
  "",
  ".top-tag {",
  "  color: var(--muted);",
  "}",
  "",
  "/* 4. Heading and introduction */",
  ".hero {",
  "  text-align: center;",
  "  padding: 42px 12px 28px;",
  "}",
  "",
  ".eyebrow {",
  "  color: var(--red);",
  "  margin: 0 0 10px;",
  "}",
  "",
  ".hero h1 {",
  "  margin: 0;",
  "  color: var(--green);",
  "  font-size: clamp(34px, 6vw, 58px);",
  "  line-height: 1.05;",
  "  font-weight: 700;",
  "  letter-spacing: -.04em;",
  "}",
  "",
  ".hero h1 span {",
  "  color: var(--red);",
  "}",
  "",
  ".intro {",
  "  max-width: 560px;",
  "  margin: 14px auto 0;",
  "  color: var(--muted);",
  "  line-height: 1.65;",
  "  font-size: 15px;",
  "  font-weight: 600;",
  "}",
  "",
  "/* 5. The game panel */",
  ".game-panel {",
  "  background-color: var(--white);",
  "  border: 2px solid var(--mint);",
  "  border-radius: 24px;",
  "  padding: 24px;",
  "}",
  "",
  ".game-toolbar {",
  "  display: flex;",
  "  justify-content: space-between;",
  "  align-items: end;",
  "  gap: 14px;",
  "  margin-bottom: 20px;",
  "}",
  "",
  ".level-control {",
  "  display: grid;",
  "  gap: 7px;",
  "}",
  "",
  ".level-control label {",
  "  color: var(--muted);",
  "}",
  "",
  ".level-control select {",
  "  min-width: 190px;",
  "  padding: 11px 38px 11px 13px;",
  "  border: 2px solid var(--mint);",
  "  border-radius: 11px;",
  "  background-color: var(--white);",
  "  color: var(--green);",
  "  font-weight: 700;",
  "}",
  "",
  ".level-control select:focus,",
  "button:focus-visible {",
  "  outline: 3px solid var(--red);",
  "  outline-offset: 2px;",
  "}",
  "",
  ".restart-button {",
  "  border: 0;",
  "  border-radius: 11px;",
  "  padding: 11px 16px;",
  "  background-color: var(--green);",
  "  color: var(--white);",
  "  font-weight: 700;",
  "  cursor: pointer;",
  "  transition: transform .2s, background-color .2s;",
  "}",
  "",
  ".restart-button:hover {",
  "  background-color: var(--green-2);",
  "  transform: translateY(-2px);",
  "}",
  "",
  ".restart-button span {",
  "  font-size: 19px;",
  "  vertical-align: -1px;",
  "  margin-right: 4px;",
  "}",
  "",
  "/* 6. Moves, matched and time */",
  ".stats {",
  "  display: grid;",
  "  grid-template-columns: repeat(3, 1fr);",
  "  gap: 10px;",
  "  margin-bottom: 14px;",
  "}",
  "",
  ".stat-box {",
  "  padding: 12px 15px;",
  "  background-color: var(--page);",
  "  border-radius: 13px;",
  "  display: flex;",
  "  align-items: center;",
  "  justify-content: space-between;",
  "  gap: 8px;",
  "}",
  "",
  ".stat-label {",
  "  color: var(--muted);",
  "}",
  "",
  ".stat-box strong {",
  "  color: var(--green);",
  "  font-size: 20px;",
  "  font-weight: 700;",
  "}",
  "",
  ".stat-box small {",
  "  font-size: 12px;",
  "  color: var(--muted);",
  "}",
  "",
  "/* 7. Progress bar */",
  ".progress-track {",
  "  height: 8px;",
  "  background-color: var(--mint);",
  "  border-radius: 20px;",
  "  overflow: hidden;",
  "  margin-bottom: 22px;",
  "}",
  "",
  ".progress-fill {",
  "  height: 100%;",
  "  width: 0%;",
  "  background-color: var(--red);",
  "  border-radius: inherit;",
  "  transition: width .35s ease;",
  "}",
  "",
  "/* 8. The card grid */",
  ".game-grid {",
  "  display: grid;",
  "  grid-template-columns: repeat(4, minmax(0, 1fr));",
  "  gap: 15px;",
  "}",
  "",
  ".memory-card {",
  "  position: relative;",
  "  min-width: 0;",
  "  aspect-ratio: 0.78;",
  "  border: 0;",
  "  padding: 0;",
  "  background-color: transparent;",
  "  cursor: pointer;",
  "  perspective: 900px;",
  "  border-radius: 19px;",
  "}",
  "",
  "/* 9. The flip */",
  ".card-inner {",
  "  position: absolute;",
  "  inset: 0;",
  "  transform-style: preserve-3d;",
  "  transition: transform .55s cubic-bezier(.2, .75, .25, 1);",
  "}",
  "",
  ".memory-card.is-flipped .card-inner,",
  ".memory-card.is-matched .card-inner {",
  "  transform: rotateY(180deg);",
  "}",
  "",
  ".card-face {",
  "  position: absolute;",
  "  inset: 0;",
  "  display: flex;",
  "  flex-direction: column;",
  "  align-items: center;",
  "  justify-content: center;",
  "  backface-visibility: hidden;",
  "  -webkit-backface-visibility: hidden;",
  "  border-radius: 19px;",
  "}",
  "",
  "/* 10. Card back */",
  ".card-back {",
  "  background-color: var(--green);",
  "  border: 5px solid var(--mint);",
  "  box-shadow: 0 7px 0 #c9e3d9;",
  "  color: var(--white);",
  "}",
  "",
  ".back-symbol {",
  "  width: 55px;",
  "  height: 55px;",
  "  display: grid;",
  "  place-items: center;",
  "  border: 3px solid var(--white);",
  "  border-radius: 50%;",
  "  font-size: 29px;",
  "  font-weight: 700;",
  "}",
  "",
  ".back-caption {",
  "  margin-top: 12px;",
  "  font-size: 9px;",
  "  letter-spacing: .18em;",
  "  font-weight: 700;",
  "  color: var(--mint);",
  "}",
  "",
  "/* 11. Card front: the number card */",
  ".card-front {",
  "  transform: rotateY(180deg);",
  "  background-color: var(--white);",
  "  border: 5px solid var(--red);",
  "  box-shadow: 0 7px 0 #f5c4c6;",
  "}",
  "",
  ".number-circle {",
  "  width: min(72%, 112px);",
  "  aspect-ratio: 1;",
  "  display: grid;",
  "  place-items: center;",
  "  border-radius: 50%;",
  "  background-color: var(--red);",
  "  color: var(--white);",
  "  font-size: clamp(48px, 7vw, 82px);",
  "  line-height: 1;",
  "  font-weight: 700;",
  "}",
  "",
  ".number-word {",
  "  margin-top: 10px;",
  "  color: var(--ink);",
  "  font-size: clamp(15px, 2.1vw, 23px);",
  "  font-weight: 700;",
  "}",
  "",
  "/* 12. Matched cards turn green */",
  ".memory-card.is-matched {",
  "  cursor: default;",
  "}",
  "",
  ".memory-card.is-matched .card-front {",
  "  border-color: var(--match);",
  "  box-shadow: 0 7px 0 #c3e8da;",
  "}",
  "",
  ".memory-card.is-matched .number-circle {",
  "  background-color: var(--match);",
  "}",
  "",
  ".memory-card:disabled {",
  "  cursor: default;",
  "}",
  "",
  "/* 13. Message under the cards */",
  ".game-message {",
  "  min-height: 42px;",
  "  margin-top: 20px;",
  "  display: flex;",
  "  align-items: center;",
  "  justify-content: center;",
  "  gap: 9px;",
  "  color: var(--muted);",
  "  font-size: 13px;",
  "  font-weight: 700;",
  "}",
  "",
  ".message-dot {",
  "  width: 10px;",
  "  height: 10px;",
  "  background-color: var(--red);",
  "  border-radius: 50%;",
  "}",
  "",
  ".footer {",
  "  display: flex;",
  "  justify-content: space-between;",
  "  gap: 12px;",
  "  padding: 22px 4px 28px;",
  "  color: var(--muted);",
  "  font-size: 9px;",
  "}",
  "",
  "/* 14. The celebration screen */",
  ".win-overlay {",
  "  position: fixed;",
  "  inset: 0;",
  "  z-index: 10;",
  "  display: grid;",
  "  place-items: center;",
  "  padding: 20px;",
  "  background-color: rgba(14, 74, 63, .9);",
  "  opacity: 0;",
  "  visibility: hidden;",
  "  transition: opacity .3s, visibility .3s;",
  "}",
  "",
  ".win-overlay.show {",
  "  opacity: 1;",
  "  visibility: visible;",
  "}",
  "",
  ".win-card {",
  "  width: min(430px, 100%);",
  "  padding: 34px;",
  "  text-align: center;",
  "  background-color: var(--white);",
  "  border: 5px solid var(--red);",
  "  border-radius: 25px;",
  "  transform: translateY(18px) scale(.97);",
  "  transition: transform .35s;",
  "}",
  "",
  ".win-overlay.show .win-card {",
  "  transform: translateY(0) scale(1);",
  "}",
  "",
  ".win-spark {",
  "  width: 62px;",
  "  height: 62px;",
  "  margin: 0 auto 18px;",
  "  display: grid;",
  "  place-items: center;",
  "  border-radius: 20px;",
  "  background-color: var(--red);",
  "  color: var(--white);",
  "  font-size: 35px;",
  "}",
  "",
  ".win-card h2 {",
  "  margin: 0;",
  "  color: var(--green);",
  "  font-size: 30px;",
  "  font-weight: 700;",
  "}",
  "",
  ".win-card > p:not(.eyebrow) {",
  "  color: var(--muted);",
  "  line-height: 1.6;",
  "  font-weight: 600;",
  "}",
  "",
  ".win-stats {",
  "  display: flex;",
  "  justify-content: center;",
  "  gap: 42px;",
  "  margin: 22px 0;",
  "}",
  "",
  ".win-stats div {",
  "  display: grid;",
  "  gap: 5px;",
  "}",
  "",
  ".win-stats span {",
  "  color: var(--muted);",
  "  font-size: 10px;",
  "  font-weight: 700;",
  "  letter-spacing: .12em;",
  "}",
  "",
  ".win-stats strong {",
  "  color: var(--green);",
  "  font-size: 25px;",
  "  font-weight: 700;",
  "}",
  "",
  ".play-again-button {",
  "  width: 100%;",
  "  padding: 14px 18px;",
  "  border: 0;",
  "  border-radius: 12px;",
  "  background-color: var(--red);",
  "  color: var(--white);",
  "  font-weight: 700;",
  "  cursor: pointer;",
  "  transition: background-color .2s, transform .2s;",
  "}",
  "",
  ".play-again-button:hover {",
  "  background-color: var(--red-dark);",
  "  transform: translateY(-2px);",
  "}",
  "",
  ".play-again-button span {",
  "  margin-left: 8px;",
  "  font-size: 18px;",
  "}",
  "",
  "/* 15. Smaller screens (phones) */",
  "@media (max-width: 650px) {",
  "  .app-shell {",
  "    width: min(100% - 22px, 520px);",
  "  }",
  "",
  "  .topbar {",
  "    min-height: 68px;",
  "  }",
  "",
  "  .top-tag {",
  "    font-size: 8px;",
  "  }",
  "",
  "  .hero {",
  "    padding: 34px 5px 22px;",
  "  }",
  "",
  "  .intro {",
  "    font-size: 13px;",
  "  }",
  "",
  "  .game-panel {",
  "    padding: 15px;",
  "    border-radius: 19px;",
  "  }",
  "",
  "  .game-grid {",
  "    gap: 10px;",
  "  }",
  "",
  "  .memory-card {",
  "    aspect-ratio: .73;",
  "  }",
  "",
  "  .card-front,",
  "  .card-back {",
  "    border-width: 3px;",
  "    border-radius: 13px;",
  "  }",
  "",
  "  .number-circle {",
  "    width: 76%;",
  "    font-size: clamp(34px, 10vw, 58px);",
  "  }",
  "",
  "  .number-word {",
  "    margin-top: 7px;",
  "    font-size: clamp(11px, 3vw, 16px);",
  "  }",
  "",
  "  .back-symbol {",
  "    width: 42px;",
  "    height: 42px;",
  "    font-size: 23px;",
  "  }",
  "",
  "  .back-caption {",
  "    font-size: 7px;",
  "  }",
  "",
  "  .stat-box {",
  "    padding: 10px 9px;",
  "    display: grid;",
  "    gap: 3px;",
  "  }",
  "",
  "  .stat-label {",
  "    font-size: 8px;",
  "  }",
  "",
  "  .stat-box strong {",
  "    font-size: 17px;",
  "  }",
  "",
  "  .footer {",
  "    font-size: 8px;",
  "  }",
  "}",
  "",
  "@media (max-width: 390px) {",
  "  .game-grid {",
  "    gap: 7px;",
  "  }",
  "",
  "  .game-panel {",
  "    padding: 11px;",
  "  }",
  "",
  "  .level-control select {",
  "    min-width: 155px;",
  "  }",
  "",
  "  .restart-button {",
  "    padding: 10px 11px;",
  "  }",
  "}",
  "",
  "@media (prefers-reduced-motion: reduce) {",
  "  *,",
  "  *::before,",
  "  *::after {",
  "    transition-duration: .01ms !important;",
  "    animation-duration: .01ms !important;",
  "  }",
  "}"
 ],
 "js": [
  "// ============================================",
  "// NUMBER MATCH — script.js",
  "// ============================================",
  "",
  "const numberWords = {",
  "  1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\",",
  "  5: \"Five\", 6: \"Six\", 7: \"Seven\", 8: \"Eight\"",
  "};",
  "",
  "// 1. Find the parts of the page we need.",
  "const gameGrid = document.getElementById(\"gameGrid\");",
  "const difficulty = document.getElementById(\"difficulty\");",
  "const movesDisplay = document.getElementById(\"moves\");",
  "const matchedDisplay = document.getElementById(\"matched\");",
  "const timerDisplay = document.getElementById(\"timer\");",
  "const progressFill = document.getElementById(\"progressFill\");",
  "const gameMessage = document.getElementById(\"gameMessage\");",
  "const restartButton = document.getElementById(\"restartButton\");",
  "const winOverlay = document.getElementById(\"winOverlay\");",
  "const finalMoves = document.getElementById(\"finalMoves\");",
  "const finalTime = document.getElementById(\"finalTime\");",
  "const playAgainButton = document.getElementById(\"playAgainButton\");",
  "",
  "// 2. Variables: what the game needs to remember.",
  "let firstCard = null;",
  "let secondCard = null;",
  "let lockBoard = false;",
  "let moves = 0;",
  "let matchedPairs = 0;",
  "let totalPairs = Number(difficulty.value);",
  "let seconds = 0;",
  "let timerInterval = null;",
  "let hasStarted = false;",
  "let mismatchTimeout = null;",
  "let winTimeout = null;",
  "",
  "// 3. Browser-generated sound effects (Web Audio API).",
  "let audioContext = null;",
  "",
  "function playTone(frequency, duration = 0.11, type = \"sine\", volume = 0.045) {",
  "  try {",
  "    audioContext = audioContext ||",
  "      new (window.AudioContext || window.webkitAudioContext)();",
  "",
  "    if (audioContext.state === \"suspended\") {",
  "      audioContext.resume();",
  "    }",
  "",
  "    const oscillator = audioContext.createOscillator();",
  "    const gain = audioContext.createGain();",
  "",
  "    oscillator.type = type;",
  "    oscillator.frequency.value = frequency;",
  "",
  "    gain.gain.setValueAtTime(volume, audioContext.currentTime);",
  "    gain.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + duration);",
  "",
  "    oscillator.connect(gain);",
  "    gain.connect(audioContext.destination);",
  "",
  "    oscillator.start();",
  "    oscillator.stop(audioContext.currentTime + duration);",
  "  } catch (error) {",
  "    // The game still works if Web Audio is unavailable.",
  "  }",
  "}",
  "",
  "// 4. The timer.",
  "// Start the timer when the first card is selected.",
  "function startTimer() {",
  "  if (hasStarted) return;",
  "",
  "  hasStarted = true;",
  "",
  "  timerInterval = setInterval(() => {",
  "    seconds += 1;",
  "    timerDisplay.textContent = formatTime(seconds);",
  "  }, 1000);",
  "}",
  "",
  "// Stop the timer.",
  "function stopTimer() {",
  "  clearInterval(timerInterval);",
  "  timerInterval = null;",
  "}",
  "",
  "// Convert seconds into minutes and seconds, like 01:05.",
  "function formatTime(totalSeconds) {",
  "  const minutes = Math.floor(totalSeconds / 60).toString().padStart(2, \"0\");",
  "  const remainingSeconds = (totalSeconds % 60).toString().padStart(2, \"0\");",
  "",
  "  return `${minutes}:${remainingSeconds}`;",
  "}",
  "",
  "// 5. The cards.",
  "// Create matching number pairs and shuffle them.",
  "function createDeck(pairCount) {",
  "  const values = Array.from({ length: pairCount }, (_, index) => index + 1);",
  "",
  "  return shuffle([...values, ...values]);",
  "}",
  "",
  "// Shuffle the cards randomly.",
  "function shuffle(items) {",
  "  const shuffled = [...items];",
  "",
  "  for (let index = shuffled.length - 1; index > 0; index -= 1) {",
  "    const randomIndex = Math.floor(Math.random() * (index + 1));",
  "",
  "    [shuffled[index], shuffled[randomIndex]] =",
  "      [shuffled[randomIndex], shuffled[index]];",
  "  }",
  "",
  "  return shuffled;",
  "}",
  "",
  "// Create an individual memory card.",
  "function createCard(number, index) {",
  "  const card = document.createElement(\"button\");",
  "",
  "  card.type = \"button\";",
  "  card.className = \"memory-card\";",
  "  card.dataset.number = String(number);",
  "  card.dataset.index = String(index);",
  "  card.setAttribute(\"aria-label\", `Card ${index + 1}, face down`);",
  "  card.setAttribute(\"aria-pressed\", \"false\");",
  "",
  "  card.innerHTML = `",
  "    <span class=\"card-inner\">",
  "      <span class=\"card-face card-back\" aria-hidden=\"true\">",
  "        <span class=\"back-symbol\">?</span>",
  "        <span class=\"back-caption\">FLIP ME</span>",
  "      </span>",
  "      <span class=\"card-face card-front\" aria-hidden=\"true\">",
  "        <span class=\"number-circle\">${number}</span>",
  "        <span class=\"number-word\">${numberWords[number]}</span>",
  "      </span>",
  "    </span>",
  "  `;",
  "",
  "  card.addEventListener(\"click\", () => flipCard(card));",
  "",
  "  return card;",
  "}",
  "",
  "// Build the game board.",
  "function buildBoard() {",
  "  gameGrid.innerHTML = \"\";",
  "",
  "  const deck = createDeck(totalPairs);",
  "",
  "  deck.forEach((number, index) => {",
  "    gameGrid.appendChild(createCard(number, index));",
  "  });",
  "",
  "  updateStats();",
  "}",
  "",
  "// 6. Playing the game.",
  "// Handle card flipping.",
  "function flipCard(card) {",
  "  if (",
  "    lockBoard ||",
  "    card === firstCard ||",
  "    card.classList.contains(\"is-matched\") ||",
  "    card.classList.contains(\"is-flipped\")",
  "  ) {",
  "    return;",
  "  }",
  "",
  "  startTimer();",
  "",
  "  card.classList.add(\"is-flipped\");",
  "  card.setAttribute(\"aria-pressed\", \"true\");",
  "  card.setAttribute(\"aria-label\", `Number ${card.dataset.number}, ${numberWords[card.dataset.number]}`);",
  "",
  "  playTone(520, 0.07, \"triangle\");",
  "",
  "  if (!firstCard) {",
  "    firstCard = card;",
  "    setMessage(\"Great! Now find its matching number.\");",
  "    return;",
  "  }",
  "",
  "  secondCard = card;",
  "",
  "  moves += 1;",
  "",
  "  updateStats();",
  "",
  "  checkForMatch();",
  "}",
  "",
  "// Check whether the selected cards match.",
  "function checkForMatch() {",
  "  const isMatch = firstCard.dataset.number === secondCard.dataset.number;",
  "",
  "  if (isMatch) {",
  "    firstCard.classList.add(\"is-matched\");",
  "    secondCard.classList.add(\"is-matched\");",
  "",
  "    firstCard.disabled = true;",
  "    secondCard.disabled = true;",
  "",
  "    matchedPairs += 1;",
  "",
  "    playTone(740, 0.13, \"sine\", 0.055);",
  "    setMessage(\"Yes! You found a matching pair. Well done!\");",
  "",
  "    resetTurn();",
  "    updateStats();",
  "",
  "    if (matchedPairs === totalPairs) {",
  "      finishGame();",
  "    }",
  "  } else {",
  "    lockBoard = true;",
  "",
  "    setMessage(\"Not a match this time. Have another try!\");",
  "    playTone(220, 0.16, \"sine\", 0.035);",
  "",
  "    mismatchTimeout = setTimeout(() => {",
  "      firstCard.classList.remove(\"is-flipped\");",
  "      secondCard.classList.remove(\"is-flipped\");",
  "",
  "      firstCard.setAttribute(\"aria-pressed\", \"false\");",
  "      secondCard.setAttribute(\"aria-pressed\", \"false\");",
  "",
  "      firstCard.setAttribute(\"aria-label\", \"Face-down memory card\");",
  "      secondCard.setAttribute(\"aria-label\", \"Face-down memory card\");",
  "",
  "      resetTurn();",
  "    }, 850);",
  "  }",
  "}",
  "",
  "// Reset the current turn.",
  "function resetTurn() {",
  "  [firstCard, secondCard] = [null, null];",
  "  lockBoard = false;",
  "}",
  "",
  "// 7. Showing progress.",
  "// Update moves, matches, timer and progress.",
  "function updateStats() {",
  "  movesDisplay.textContent = moves;",
  "  matchedDisplay.innerHTML = `${matchedPairs} <small>/ ${totalPairs}</small>`;",
  "  timerDisplay.textContent = formatTime(seconds);",
  "  progressFill.style.width = `${(matchedPairs / totalPairs) * 100}%`;",
  "}",
  "",
  "// Update the message displayed below the cards.",
  "function setMessage(message) {",
  "  gameMessage.textContent = message;",
  "}",
  "",
  "// 8. Winning and starting again.",
  "// Finish the game when all pairs are matched.",
  "function finishGame() {",
  "  stopTimer();",
  "",
  "  finalMoves.textContent = moves;",
  "  finalTime.textContent = formatTime(seconds);",
  "",
  "  setMessage(\"Amazing! You matched every pair.\");",
  "",
  "  winTimeout = setTimeout(() => {",
  "    winOverlay.classList.add(\"show\");",
  "    winOverlay.setAttribute(\"aria-hidden\", \"false\");",
  "",
  "    playTone(660, 0.16, \"sine\", 0.05);",
  "    setTimeout(() => playTone(830, 0.2, \"sine\", 0.05), 130);",
  "    setTimeout(() => playTone(990, 0.24, \"sine\", 0.05), 280);",
  "",
  "    playAgainButton.focus();",
  "  }, 450);",
  "}",
  "",
  "// Start a fresh game.",
  "function startNewGame() {",
  "  clearTimeout(mismatchTimeout);",
  "  clearTimeout(winTimeout);",
  "  stopTimer();",
  "",
  "  firstCard = null;",
  "  secondCard = null;",
  "  lockBoard = false;",
  "",
  "  moves = 0;",
  "  matchedPairs = 0;",
  "  seconds = 0;",
  "  hasStarted = false;",
  "",
  "  totalPairs = Number(difficulty.value);",
  "",
  "  winOverlay.classList.remove(\"show\");",
  "  winOverlay.setAttribute(\"aria-hidden\", \"true\");",
  "",
  "  setMessage(\"Choose any card to begin!\");",
  "",
  "  buildBoard();",
  "}",
  "",
  "// Button event listeners.",
  "restartButton.addEventListener(\"click\", startNewGame);",
  "playAgainButton.addEventListener(\"click\", startNewGame);",
  "difficulty.addEventListener(\"change\", startNewGame);",
  "",
  "// Start the game when the page loads.",
  "startNewGame();"
 ]
}